__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/
.pytest_cache/

# raw and processed data (large, regenerate via data/download_data.py +
# src/preprocessing.py rather than committing binary data to git)
data/raw/*/
data/processed/*/
data/raw/*.zip
!data/raw/*/.gitkeep
!data/processed/*/.gitkeep

# model checkpoints (large binaries)
checkpoints/*/
!checkpoints/*/.gitkeep

# logs (regenerable)
results/logs/*
!results/logs/.gitkeep

# OS / editor junk
.DS_Store
Thumbs.db
.idea/
.vscode/
# archived checkpoints (large binaries)
results/archive/*/checkpoints/

# smoke-test output and CSV lock files
results/smoke/
*.lock
